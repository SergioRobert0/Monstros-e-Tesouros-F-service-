extends RefCounted

const TURN_START := "TURN_START"
const HAND_REFRESH := "HAND_REFRESH"
const PATH_SELECTION := "PATH_SELECTION"
const TAVERN := "TAVERN"
const TEMPLE := "TEMPLE"
const TERRAIN_REVEAL := "TERRAIN_REVEAL"
const TERRAIN_REJECT_CHECK := "TERRAIN_REJECT_CHECK"
const MONSTER_REVEAL := "MONSTER_REVEAL"
const COMBAT_SETUP := "COMBAT_SETUP"
const INITIATIVE := "INITIATIVE"
const ACTIONS := "ACTIONS"
const GROUP_POWER := "GROUP_POWER"
const WOUND_RESOLUTION := "WOUND_RESOLUTION"
const COMBAT_RESULT := "COMBAT_RESULT"
const ESCAPE_RESOLUTION := "ESCAPE_RESOLUTION"
const ELIMINATION_CHECK := "ELIMINATION_CHECK"
const REWARDS := "REWARDS"
const POST_COMBAT := "POST_COMBAT"
const TURN_END := "TURN_END"
const GAME_OVER_CHECK := "GAME_OVER_CHECK"
const NEXT_PLAYER := "NEXT_PLAYER"
const GAME_OVER := "GAME_OVER"

const TRANSITIONS := {
	TURN_START: [HAND_REFRESH], HAND_REFRESH: [PATH_SELECTION],
	PATH_SELECTION: [TAVERN, TEMPLE, TERRAIN_REVEAL],
	TAVERN: [TURN_END], TEMPLE: [TURN_END],
	TERRAIN_REVEAL: [TERRAIN_REJECT_CHECK, MONSTER_REVEAL, TURN_END],
	TERRAIN_REJECT_CHECK: [TERRAIN_REVEAL, TURN_END],
	MONSTER_REVEAL: [COMBAT_SETUP], COMBAT_SETUP: [INITIATIVE],
	INITIATIVE: [ACTIONS], ACTIONS: [GROUP_POWER],
	GROUP_POWER: [WOUND_RESOLUTION], WOUND_RESOLUTION: [COMBAT_RESULT],
	COMBAT_RESULT: [INITIATIVE, REWARDS, ELIMINATION_CHECK, ESCAPE_RESOLUTION],
	ESCAPE_RESOLUTION: [POST_COMBAT], ELIMINATION_CHECK: [GAME_OVER_CHECK],
	REWARDS: [POST_COMBAT], POST_COMBAT: [TURN_END],
	TURN_END: [GAME_OVER_CHECK], GAME_OVER_CHECK: [NEXT_PLAYER, GAME_OVER],
	NEXT_PLAYER: [TURN_START], GAME_OVER: []
}

static func can_transition(current: String, next: String) -> bool:
	return TRANSITIONS.get(current, []).has(next)
